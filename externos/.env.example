NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ducky
DB_PASSWORD=cambia-esta-contrasena
DB_CIAA=ciaa_ducky
DB_EMPLEADOS=empleados_ducky
DB_TESORERIA=tesoreria_ducky

# Claves que cada sistema exige en el encabezado X-Clave-Api.
# Deben coincidir con las de server/.env (EXT_*_CLAVE).
CLAVE_CIAA=clave-ciaa-dev
CLAVE_EMPLEADOS=clave-empleados-dev
CLAVE_TESORERIA=clave-tesoreria-dev

# A dónde avisa Tesorería cuando acepta o rechaza una solicitud.
BIBLIO_URL=http://localhost:3000/api
BIBLIO_CLAVE_NOTIFICACION=clave-notificacion-dev
