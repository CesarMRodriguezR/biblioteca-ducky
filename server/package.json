{
  "name": "biblioteca-ducky-api",
  "version": "1.0.0",
  "description": "API REST (MVC) de Biblioteca Ducky - Node.js + Express + MariaDB",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "nodemon src/servidor.js",
    "test": "node --test pruebas/*.prueba.js",
    "db:reset": "mariadb -u root < ../database/01_schema.sql && mariadb -u root < ../database/02_seed.sql && mariadb -u root -e \"GRANT ALL ON biblioteca_ducky.* TO ducky@localhost\"",
    "lint": "eslint ."
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "morgan": "^1.12.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "type": "module"
}
